{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-host; Database=neondb; Username=your-username; Password=your-password; SSL Mode=Require;"
  },
  "JwtSettings": {
    "Key": "<Your-Super-Secret-Key-From-Environment-Variables>",
    "Issuer": "AgileTaskManagerAPI",
    "Audience": "AgileTaskManagerClients"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:5279",
      "https://my-agile-task-manager-frontend.com"
    ]
  },
  "AllowedHosts": "*"
}
<Window x:Class="AgileTaskManager.Desktop.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết công việc - Agile Manager" Height="700" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header Dialog -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#EAF5FC" Margin="0,0,12,0">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="#425B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chi tiết công việc" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Cập nhật tiến độ, hạn chót và danh sách việc phụ" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Scrollable Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- Task Name -->
                <TextBlock Text="TÊN CÔNG VIỆC" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                    <TextBox x:Name="txtTaskName" Padding="12,9" Background="Transparent" BorderThickness="0"
                             Foreground="#0F172A" FontSize="13" FontWeight="SemiBold"/>
                </Border>

                <!-- Description -->
                <TextBlock Text="MÔ TẢ CHI TIẾT" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                    <TextBox x:Name="txtDescription" Padding="12,8" Background="Transparent" BorderThickness="0"
                             Foreground="#0F172A" FontSize="13" Height="65" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Due Date & Assignee -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HẠN HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <DatePicker x:Name="dpDueDate" Padding="10,7" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NGƯỜI PHỤ TRÁCH" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <ComboBox x:Name="cboAssignee" Padding="10,7" Background="Transparent" BorderThickness="0"
                                      DisplayMemberPath="username" SelectedValuePath="userId" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tags -->
                <TextBlock Text="NHÃN / TAGS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                    <TextBox x:Name="txtTags" Padding="12,8" Background="Transparent" BorderThickness="0"
                             Foreground="#0F172A" FontSize="13"/>
                </Border>

                <!-- Checklist (Subtasks) Card -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Checklist Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#425B9A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Việc cần làm (Checklist)" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Items list -->
                        <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icSubtasks" ItemsSource="{Binding Subtasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,8,0" Checked="Subtask_CheckedChanged" Unchecked="Subtask_CheckedChanged" Tag="{Binding}"/>
                                                <TextBox Text="{Binding Title, Mode=TwoWay}" Grid.Column="1" VerticalAlignment="Center" Padding="4,2" Background="Transparent" BorderThickness="0" Foreground="#1E293B" FontSize="12" LostFocus="Subtask_LostFocus" Tag="{Binding}"/>
                                                <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Grid.Column="2" Width="22" Height="22" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" Click="BtnDeleteSubtask_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Quick add subtask -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                <TextBox x:Name="txtNewSubtask" Padding="8,6" Background="Transparent" BorderThickness="0"
                                         FontSize="12" Foreground="#0F172A"/>
                            </Border>
                            <Button Content="+ Thêm" Grid.Column="1" Padding="12,6" Background="#425B9A" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnAddSubtask_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Actions -->
        <Border Grid.Row="2" Padding="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Width="85" Height="36" Margin="0,0,10,0"
                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569"
                        FontWeight="SemiBold" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Lưu thay đổi" Width="110" Height="36"
                        Background="#425B9A" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="AgileTaskManager.Desktop.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="Edit Task" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

        <!-- Tên Task -->
        <TextBlock Text="Task Name:" FontWeight="SemiBold" Grid.Row="1"/>
        <TextBox x:Name="txtTaskName" Margin="0,5,0,15" Padding="5" Grid.Row="2"/>

        <!-- Mô tả -->
        <TextBlock Text="Description:" FontWeight="SemiBold" Grid.Row="3"/>
        <TextBox x:Name="txtDescription" Margin="0,5,0,15" Padding="5" Grid.Row="4" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <!-- Hạn chót -->
        <TextBlock Text="Due Date:" FontWeight="SemiBold" Grid.Row="5"/>
        <DatePicker x:Name="dpDueDate" Margin="0,5,0,15" Grid.Row="6"/>

        <Grid Grid.Row="7" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Assignee -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Assignee:" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboAssignee" Margin="0,5,0,15" Padding="5" DisplayMemberPath="username" SelectedValuePath="userId"/>
            </StackPanel>
            <!-- Tags -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Tags:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtTags" Margin="0,5,0,15" Padding="5"/>
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Background="#E5E7EB" BorderBrush="Transparent" Click="BtnCancel_Click"/>
            <Button Content="Save" Width="80" Height="30" Background="#3B82F6" Foreground="White" BorderBrush="Transparent" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>

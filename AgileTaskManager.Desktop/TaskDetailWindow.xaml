<Window x:Class="AgileTaskManager.Desktop.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details" Height="650" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Edit Task" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

        <TextBlock Text="Task Name:" FontWeight="SemiBold" Grid.Row="1"/>
        <TextBox x:Name="txtTaskName" Margin="0,5,0,15" Padding="5" Grid.Row="2"/>

        <TextBlock Text="Description:" FontWeight="SemiBold" Grid.Row="3"/>
        <TextBox x:Name="txtDescription" Margin="0,5,0,15" Padding="5" Grid.Row="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="Due Date:" FontWeight="SemiBold" Grid.Row="5"/>
        <DatePicker x:Name="dpDueDate" Margin="0,5,0,15" Grid.Row="6"/>

        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Assignee:" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboAssignee" Margin="0,5,0,5" Padding="5" DisplayMemberPath="username" SelectedValuePath="userId"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Tags:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtTags" Margin="0,5,0,5" Padding="5"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="8" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Checklist (Subtasks)" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,5"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icSubtasks" ItemsSource="{Binding Subtasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,10,0" Checked="Subtask_CheckedChanged" Unchecked="Subtask_CheckedChanged" Tag="{Binding}"/>
                                    <TextBox Text="{Binding Title, Mode=TwoWay}" Grid.Column="1" VerticalAlignment="Center" Padding="2" LostFocus="Subtask_LostFocus" Tag="{Binding}"/>
                                    <Button Content="X" Grid.Column="2" Width="20" Height="20" Background="Transparent" Foreground="Red" BorderThickness="0" Margin="5,0,0,0" Click="BtnDeleteSubtask_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtNewSubtask" Grid.Column="0" Padding="4" Margin="0,0,5,0" />
                    <Button Content="Add" Grid.Column="1" Width="50" Background="#10B981" Foreground="White" BorderThickness="0" Click="BtnAddSubtask_Click"/>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Background="#E5E7EB" BorderBrush="Transparent" Click="BtnCancel_Click"/>
            <Button Content="Save" Width="80" Height="30" Background="#3B82F6" Foreground="White" BorderBrush="Transparent" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>

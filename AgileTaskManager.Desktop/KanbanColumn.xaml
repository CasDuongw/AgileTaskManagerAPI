<UserControl x:Class="AgileTaskManager.Desktop.KanbanColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}"
             AllowDrop="True" 
             Drop="UserControl_Drop" 
             DragOver="UserControl_DragOver">

    <!-- THẺ BORDER BỌC NGOÀI (SaaS Flat Design) -->
    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Width="280" Padding="12" Margin="0,0,16,0" VerticalAlignment="Top"
            AllowDrop="True" Drop="ColumnBorder_Drop" DragOver="ColumnBorder_DragOver">
        <Border.FocusVisualStyle>
            <Style TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderThickness="0"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.FocusVisualStyle>

        <!-- [CODE MỚI ĐƯỢC THÊM VÀO]: THAY THẾ STACKPANEL THÀNH GRID CHIA 3 TẦNG -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Dòng 0: Dành cho Tiêu đề (Bao nhiêu chữ lấy bấy nhiêu cao) -->
                <RowDefinition Height="Auto"/>
                <!-- Dòng 1: Dành cho Danh sách Task (Dấu * ép nó lấp đầy phần trống và tự sinh thanh cuộn nếu quá dài) -->
                <RowDefinition Height="*"/>
                <!-- Dòng 2: Dành cho Nút/Form thêm thẻ mới -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TẦNG 0: Tiêu đề cột & Nút Xóa Cột -->
            <Grid x:Name="titleGrid" Grid.Row="0" Margin="5,5,5,15" Background="Transparent" 
                  Cursor="SizeAll"
                  PreviewMouseLeftButtonDown="TitleGrid_PreviewMouseLeftButtonDown" 
                  PreviewMouseMove="TitleGrid_PreviewMouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblTitle" Text="List Title" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="btnDeleteColumn" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="BtnDeleteColumn_Click" Grid.Column="1" Foreground="#64748B" Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand" Visibility="Hidden" Padding="5,0,0,0"/>
            </Grid>

            <!-- TẦNG 1: spTaskList nay đã được bảo kê bởi ScrollViewer -->
            <!-- Thuộc tính VerticalScrollBarVisibility="Auto" sẽ tự động hiện thanh cuộn khi task tràn viền -->
            <!-- TẦNG 1 [Đã sửa]: Chuyển AllowDrop lên ScrollViewer và thêm Background trong suốt -->
            <ScrollViewer Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0" Margin="0,0,0,5">
                <StackPanel x:Name="spTaskList"/>
            </ScrollViewer>

            <!-- TẦNG 2: Khu vực Thêm Thẻ -->
            <Grid Grid.Row="2" Margin="0,5,0,0">
                <Button x:Name="btnShowAddCard" Click="BtnShowAddCard_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8" Cursor="Hand" Margin="0,4,0,0" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add a card" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="panelAddCardInput" Visibility="Collapsed" Margin="0,8,0,0">
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                        <TextBox x:Name="txtNewTaskName" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="12" BorderThickness="0" Background="Transparent" Foreground="#0F172A" VerticalContentAlignment="Top" PreviewKeyDown="TxtNewTaskName_PreviewKeyDown"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add card" Click="BtnConfirmAddCard_Click" Background="#0D6EFD" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="16,8" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="BtnCancelAddCard_Click" FontSize="14" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="12,0,0,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
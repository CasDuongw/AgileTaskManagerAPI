<UserControl x:Class="AgileTaskManager.Desktop.KanbanColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}"
             Background="Transparent"
             AllowDrop="True" 
             Drop="UserControl_Drop" 
             DragOver="UserControl_DragOver">

    <!-- THẺ BORDER BỌC NGOÀI (Modern Flat SaaS Design) -->
    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Width="285" Padding="10,10,10,8" Margin="0,0,16,0" VerticalAlignment="Top"
            AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
        <Border.FocusVisualStyle>
            <Style TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderThickness="0"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.FocusVisualStyle>

        <Grid Background="Transparent" AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
            <Grid.RowDefinitions>
                <!-- Dòng 0: Tiêu đề cột & trạng thái -->
                <RowDefinition Height="Auto"/>
                <!-- Dòng 1: Danh sách Task với thanh cuộn tự động -->
                <RowDefinition Height="Auto"/>
                <!-- Dòng 2: Nút/Form thêm thẻ mới -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TẦNG 0: Tiêu đề cột & Nút Xóa Cột -->
            <Grid x:Name="titleGrid" Grid.Row="0" Margin="4,2,4,8" Background="Transparent" 
                  Cursor="SizeAll"
                  PreviewMouseLeftButtonDown="TitleGrid_PreviewMouseLeftButtonDown" 
                  PreviewMouseMove="TitleGrid_PreviewMouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding ColumnName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="txtTitle" Text="{Binding ColumnName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="TxtTitle_LostFocus" KeyDown="TxtTitle_KeyDown" IsVisibleChanged="TxtTitle_IsVisibleChanged" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Background="White" BorderThickness="1" BorderBrush="#425B9A" TextWrapping="Wrap" Padding="4,2">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Trạng thái: " FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Border Background="#FFF6DC" BorderBrush="#FCE8A6" BorderThickness="1" CornerRadius="6">
                            <ComboBox ItemsSource="{Binding Statuses}" 
                                      SelectedValue="{Binding Status, Mode=TwoWay}"
                                      SelectionChanged="CboStatus_SelectionChanged"
                                      FontSize="11" Padding="6,2" Background="Transparent" Foreground="#7A5E12" BorderThickness="0" MinWidth="105">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#7A5E12" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="btnDeleteColumn" Grid.Column="1" Orientation="Horizontal" Visibility="Hidden" VerticalAlignment="Center">
                    <Button Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding EditColumnTitleCommand}" Foreground="#64748B" Background="Transparent" BorderThickness="0" FontSize="13" Cursor="Hand" Padding="4" ToolTip="Sửa tên"/>
                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="BtnDeleteColumn_Click" Foreground="#FF95A5" Background="Transparent" BorderThickness="0" FontSize="13" Cursor="Hand" Padding="4" ToolTip="Xóa cột"/>
                </StackPanel>
            </Grid>

            <!-- TẦNG 1: Danh sách task -->
            <ScrollViewer Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                          Padding="0,0,2,0" Margin="0,0,0,2" MaxHeight="540"
                          AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
                <ItemsControl x:Name="icTaskList" ItemsSource="{Binding Tasks}" Background="Transparent" AllowDrop="True"
                              Drop="UserControl_Drop" DragOver="UserControl_DragOver">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Padding="10,7" Margin="0,0,0,6" BorderThickness="1" BorderBrush="#E2E8F0" AllowDrop="True" Tag="{Binding TaskId}"
                                    Drop="UserControl_Drop" DragOver="UserControl_DragOver"
                                    PreviewMouseLeftButtonDown="Task_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Task_PreviewMouseMove" Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#425B9A" BlurRadius="5" ShadowDepth="1" Opacity="0.06" />
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              Foreground="#0F172A" FontWeight="Medium" FontSize="13" 
                                              VerticalAlignment="Center" VerticalContentAlignment="Center" 
                                              Margin="0" Padding="8,0,0,0" Grid.Column="0" Cursor="Hand"
                                              FocusVisualStyle="{x:Null}">
                                        <TextBlock Text="{Binding TaskName}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>

                                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,0,0">
                                        <Button Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#64748B" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="3,2" Margin="0,0,2,0" Command="{Binding EditTaskCommand}" ToolTip="Chỉnh sửa công việc" FocusVisualStyle="{x:Null}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#425B9A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="3,2" Click="BtnDeleteTask_Click" ToolTip="Xóa công việc" FocusVisualStyle="{x:Null}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#FF95A5"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- TẦNG 2: Khu vực Thêm Thẻ -->
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Button x:Name="btnShowAddCard" Click="BtnShowAddCard_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,6" Cursor="Hand" Margin="0" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EAF5FC"/>
                                    <Setter Property="Foreground" Value="#425B9A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thêm công việc" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="panelAddCardInput" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Background="#FFFFFF" BorderBrush="#425B9A" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,8">
                        <TextBox x:Name="txtNewTaskName" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" BorderThickness="0" Background="Transparent" Foreground="#0F172A" FontSize="13" VerticalContentAlignment="Top" PreviewKeyDown="TxtNewTaskName_PreviewKeyDown"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Thêm việc" Click="BtnConfirmAddCard_Click" Background="#425B9A" Foreground="White" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Padding="12,6" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="BtnCancelAddCard_Click" FontSize="12" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
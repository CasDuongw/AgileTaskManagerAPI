<Window x:Class="AgileTaskManager.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agile Manager - Dashboard" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Semantic Color Palette (Clean SaaS) -->
        <SolidColorBrush x:Key="ColorPrimary" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="ColorPrimaryHover" Color="#F0F5FF"/>
        <SolidColorBrush x:Key="ColorBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ColorSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ColorTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="ColorTextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="ColorSuccess" Color="#10B981"/>

        <!-- Style chuẩn cho các Nút Menu ở Sidebar -->
        <Style TargetType="Button" x:Key="MenuBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="16,4,16,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho Menu Button đang được chọn -->
        <Style TargetType="Button" x:Key="ActiveMenuBtn" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="Background" Value="{StaticResource ColorPrimaryHover}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho các textbox trong màn Create -->
        <Style x:Key="CreateTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho các form trong màn Create -->
        <Style TargetType="Border" x:Key="FormCard">
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Nút bấm chính (Call to Action) -->
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR (CỘT TRÁI) - Phẳng, không bóng đổ, dùng viền phải -->
        <Border Grid.Column="0" Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,32,0,0">
                <Button x:Name="btnMenuDashboard" Style="{StaticResource ActiveMenuBtn}" Click="btnMenuDashboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="32" FontSize="16" TextAlignment="Center"/>
                        <TextBlock Text="Dashboard" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="32" FontSize="16" TextAlignment="Center"/>
                        <TextBlock Text="Projects" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="32" FontSize="16" TextAlignment="Center"/>
                        <TextBlock Text="Team Directory" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnMenuCreate" Style="{StaticResource MenuBtn}" Click="btnMenuCreate_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="32" FontSize="16" TextAlignment="Center"/>
                        <TextBlock Text="Create" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="32" FontSize="16" TextAlignment="Center"/>
                        <TextBlock Text="Files" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="32" FontSize="16" TextAlignment="Center"/>
                        <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT (CỘT PHẢI) -->
        <Border Grid.Column="1" Padding="48,40,48,40">
            <Grid>
                <!-- VIEW 1: KANBAN DASHBOARD (Mặc định hiện) -->
                <Grid x:Name="viewDashboard" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề & Chọn Project -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Dashboard" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Project:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <Border Background="{StaticResource ColorSurface}" CornerRadius="8" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                                <ComboBox x:Name="cboProjects" Width="240" Height="40" FontSize="14" Padding="12,8" 
                                          DisplayMemberPath="projectName" SelectedValuePath="projectId" 
                                          SelectionChanged="CboProjects_SelectionChanged"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Đường kẻ mảnh phân cách Header -->
                    <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource ColorBorder}" Margin="0,0,0,32"/>

                    <!-- KHU VỰC BẢNG KANBAN -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                        <!-- BẢNG KANBAN TỔNG (spBoard) -->
                        <StackPanel x:Name="spBoard" Orientation="Horizontal">

                            <!-- NƠI ĐÂY SẼ LÀ CHỖ CÁC CỘT ĐƯỢC C# ĐÚC VÀ BƠM VÀO -->

                            <!-- KHU VỰC NHẬP TẠO DANH SÁCH MỚI -->
                            <StackPanel VerticalAlignment="Top" Margin="0,0,16,0">

                                <!-- Nút Thêm Danh Sách Khác -->
                                <Border x:Name="btnShowAddList" Background="Transparent" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Width="280" Height="48" Cursor="Hand" MouseLeftButtonDown="BtnShowAddList_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblAddListText" Text="Add new list" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Form Nhập Tên Danh Sách -->
                                <Border x:Name="panelAddListInput" Visibility="Collapsed" Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Width="280" Padding="12">
                                    <StackPanel>
                                        <Border Background="{StaticResource ColorBackground}" CornerRadius="6" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" Margin="0,0,0,12">
                                            <TextBox x:Name="txtNewListName" MinHeight="40" Padding="12,8" BorderThickness="0" Background="Transparent" Foreground="{StaticResource ColorTextPrimary}" VerticalContentAlignment="Center" PreviewKeyDown="TxtNewListName_PreviewKeyDown"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save list" Click="BtnConfirmAddList_Click" Background="{StaticResource ColorPrimary}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="16,8" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="BtnCancelAddList_Click" FontSize="14" Background="Transparent" Foreground="{StaticResource ColorTextSecondary}" BorderThickness="0" Margin="12,0,0,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: CREATE FORMS -->
                <Grid x:Name="viewCreate" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form Create User -->
                    <Border Grid.Column="0" Style="{StaticResource FormCard}">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="CREATE USER" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock Text="Username" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtUserName" Style="{StaticResource CreateTextBox}"/>
                                
                                <TextBlock Text="Email Address" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource CreateTextBox}"/>
                                
                                <TextBlock Text="Password" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                    <PasswordBox x:Name="txtPassword" Padding="12,10" Background="Transparent" Foreground="{StaticResource ColorTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <Button Grid.Row="1" Content="Create User" Click="BtnCreateUser_Click" Style="{StaticResource PrimaryBtn}" Background="{StaticResource ColorPrimary}"/>
                        </Grid>
                    </Border>

                    <!-- Form Create Project -->
                    <Border Grid.Column="1" Style="{StaticResource FormCard}">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="CREATE PROJECT" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock Text="Project Name" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtProjectName" Style="{StaticResource CreateTextBox}"/>
                                
                                <TextBlock Text="Owner ID" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtOwnerId" Style="{StaticResource CreateTextBox}"/>
                            </StackPanel>
                            
                            <Button Grid.Row="1" Content="Create Project" Click="BtnCreateProject_Click" Style="{StaticResource PrimaryBtn}" Background="{StaticResource ColorPrimary}"/>
                        </Grid>
                    </Border>

                    <!-- Form Create Task -->
                    <Border Grid.Column="2" Style="{StaticResource FormCard}">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource ColorSuccess}" VerticalAlignment="Center"/>
                                    <TextBlock Text="CREATE TASK" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock Text="Task Description" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtTaskName" Style="{StaticResource CreateTextBox}"/>
                                
                                <TextBlock Text="Project ID" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtProjectId" Style="{StaticResource CreateTextBox}"/>
                            </StackPanel>
                            
                            <Button Grid.Row="1" Content="Create Task" Click="BtnCreateTask_Click" Style="{StaticResource PrimaryBtn}" Background="{StaticResource ColorSuccess}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
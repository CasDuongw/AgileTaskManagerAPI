<Window x:Class="AgileTaskManager.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agile Manager - Dashboard" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style chuẩn cho các Nút Menu ở Sidebar -->
        <Style TargetType="Button" x:Key="MenuBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5E6C84"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="15,4,15,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBECF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho Menu Button đang được chọn -->
        <Style TargetType="Button" x:Key="ActiveMenuBtn" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="Background" Value="#E9F2FF"/>
            <Setter Property="Foreground" Value="#0052CC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DEEBFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho các textbox trong màn Create -->
        <Style x:Key="CreateTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style cho các form trong màn Create -->
        <Style TargetType="StackPanel" x:Key="FormPanel">
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Background" Value="#F8F9FA"/>
        </Style>

        <Style TargetType="Button" x:Key="TrelloBtn">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR (CỘT TRÁI) -->
        <Border Grid.Column="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="#D9D9D9" Opacity="0.4" Direction="0"/>
            </Border.Effect>

            <StackPanel Margin="0,40,0,0">
                <Button x:Name="btnMenuDashboard" Style="{StaticResource ActiveMenuBtn}" Click="btnMenuDashboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❖" Width="30" FontSize="16" TextAlignment="Center"/>
                        <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="|||" Width="30" FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="Projects" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥" Width="30" FontSize="14" TextAlignment="Center"/>
                        <TextBlock Text="Team Directory" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnMenuCreate" Style="{StaticResource MenuBtn}" Click="btnMenuCreate_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Width="30" FontSize="14" TextAlignment="Center"/>
                        <TextBlock Text="Create" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Width="30" FontSize="14" TextAlignment="Center"/>
                        <TextBlock Text="Files" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuBtn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" Width="30" FontSize="14" TextAlignment="Center"/>
                        <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT (CỘT PHẢI) -->
        <Border Grid.Column="1" Padding="50,40,50,40">
            <Grid>
                <!-- VIEW 1: KANBAN DASHBOARD (Mặc định hiện) -->
                <Grid x:Name="viewDashboard" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề + chọn dự án -->
                <!-- Tiêu đề & Chọn Project -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <!-- Cột trái chứa chữ Hello (Tự động đẩy ra) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Cột phải chứa ComboBox (Vừa khít nội dung) -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hello, Sir" FontSize="34" FontWeight="ExtraBlack" Foreground="#091E42" VerticalAlignment="Center"/>

                    <!-- [MỚI] ComboBox chọn Dự án nằm sát lề phải -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📁 Dự án:" FontSize="16" FontWeight="SemiBold" Foreground="#5E6C84" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <ComboBox x:Name="cboProjects" Width="220" Height="40" FontSize="15" Padding="10,8" 
                                  DisplayMemberPath="projectName" SelectedValuePath="projectId" 
                                  SelectionChanged="CboProjects_SelectionChanged"
                                  Background="White" BorderBrush="#DFE1E6" BorderThickness="2" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Đường kẻ mảnh -->
                <Rectangle Grid.Row="1" Height="1" Fill="#DFE1E6" Margin="0,0,0,30"/>

                <!-- KHU VỰC BẢNG KANBAN -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                    <!-- BẢNG KANBAN TỔNG (spBoard) -->
                    <StackPanel x:Name="spBoard" Orientation="Horizontal">

                        <!-- NƠI ĐÂY SẼ LÀ CHỖ CÁC CỘT ĐƯỢC C# ĐÚC VÀ BƠM VÀO -->

                        <!-- KHU VỰC NHẬP TẠO DANH SÁCH MỚI (Luôn nằm ở cuối cùng bên phải) -->
                        <StackPanel VerticalAlignment="Top" Margin="0,0,15,0">

                            <!-- Nút Thêm Danh Sách Khác -->
                            <Border x:Name="btnShowAddList" Background="#14000000" CornerRadius="8" Width="280" Height="45" Cursor="Hand" MouseLeftButtonDown="BtnShowAddList_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="+" FontSize="18" FontWeight="SemiBold" Foreground="#172B4D" Margin="0,-2,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblAddListText" Text="Thêm danh sách" FontSize="14" FontWeight="SemiBold" Foreground="#172B4D" Margin="0,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Form Nhập Tên Danh Sách -->
                            <Border x:Name="panelAddListInput" Visibility="Collapsed" Background="#EBECF0" CornerRadius="8" Width="280" Padding="10">
                                <StackPanel>
                                    <Border Background="White" CornerRadius="6" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#091E42" Opacity="0.15"/>
                                        </Border.Effect>
                                        <TextBox x:Name="txtNewListName" MinHeight="40" Padding="10" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" PreviewKeyDown="TxtNewListName_PreviewKeyDown"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Thêm danh sách" Click="BtnConfirmAddList_Click" Background="#0052CC" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="✕" Click="BtnCancelAddList_Click" FontSize="16" Background="Transparent" Foreground="#5E6C84" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: CREATE FORMS (Mặc định ẩn) -->
                <Grid x:Name="viewCreate" Visibility="Collapsed" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form Create User -->
                    <StackPanel Grid.Column="0" Style="{StaticResource FormPanel}">
                        <TextBlock Text="👤 TẠO USER" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#172B4D"/>
                        <TextBlock Text="Tên người dùng:" Foreground="#5E6C84" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtUserName" Style="{StaticResource CreateTextBox}"/>
                        <TextBlock Text="Email:" Foreground="#5E6C84" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource CreateTextBox}"/>
                        <TextBlock Text="Mật khẩu:" Foreground="#5E6C84" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="txtPassword" Margin="0,0,0,25" Padding="10,8" Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="2" VerticalContentAlignment="Center"/>
                        <Button Content="LƯU USER" Click="BtnCreateUser_Click" Style="{StaticResource TrelloBtn}" Background="#0052CC"/>
                    </StackPanel>

                    <!-- Form Create Project -->
                    <StackPanel Grid.Column="1" Style="{StaticResource FormPanel}">
                        <TextBlock Text="📁 TẠO DỰ ÁN" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#172B4D"/>
                        <TextBlock Text="Tên dự án:" Foreground="#5E6C84" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtProjectName" Style="{StaticResource CreateTextBox}"/>
                        <TextBlock Text="ID User Quản lý:" Foreground="#5E6C84" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtOwnerId" Style="{StaticResource CreateTextBox}"/>
                        <Button Content="LƯU DỰ ÁN" Click="BtnCreateProject_Click" Style="{StaticResource TrelloBtn}" Background="#0052CC"/>
                    </StackPanel>

                    <!-- Form Create Task -->
                    <StackPanel Grid.Column="2" Style="{StaticResource FormPanel}">
                        <TextBlock Text="📝 THÊM TASK MỚI" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#172B4D"/>
                        <TextBlock Text="Nội dung công việc:" Foreground="#5E6C84" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtTaskName" Style="{StaticResource CreateTextBox}"/>
                        <TextBlock Text="Thuộc ID Dự án nào?:" Foreground="#5E6C84" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtProjectId" Style="{StaticResource CreateTextBox}"/>
                        <Button Content="THÊM TASK" Click="BtnCreateTask_Click" Style="{StaticResource TrelloBtn}" Background="#5AAC44"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
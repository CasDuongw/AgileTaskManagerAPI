<Window x:Class="AgileTaskManager.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgileTaskManager.Desktop"
        Title="Agile Manager - Dashboard" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- 4-Color Palette Brushes from User -->
        <SolidColorBrush x:Key="ColorPrimary" Color="#425B9A"/>
        <SolidColorBrush x:Key="ColorPrimaryHover" Color="#33487A"/>
        <SolidColorBrush x:Key="ColorPrimaryLight" Color="#EEF2FA"/>

        <SolidColorBrush x:Key="ColorSky" Color="#76C0EC"/>
        <SolidColorBrush x:Key="ColorSkyLight" Color="#EAF5FC"/>
        <SolidColorBrush x:Key="ColorAccent" Color="#76C0EC"/>
        <SolidColorBrush x:Key="ColorAccentLight" Color="#EAF5FC"/>

        <SolidColorBrush x:Key="ColorCream" Color="#FFF6DC"/>
        <SolidColorBrush x:Key="ColorCreamLight" Color="#FFFBF0"/>
        <SolidColorBrush x:Key="ColorCreamBorder" Color="#FCE8A6"/>
        <SolidColorBrush x:Key="ColorCreamText" Color="#7A5E12"/>

        <SolidColorBrush x:Key="ColorPink" Color="#FF95A5"/>
        <SolidColorBrush x:Key="ColorPinkLight" Color="#FFF0F2"/>
        <SolidColorBrush x:Key="ColorPinkHover" Color="#F47E90"/>
        <SolidColorBrush x:Key="ColorPinkBorder" Color="#FFCCD4"/>
        <SolidColorBrush x:Key="ColorPinkText" Color="#D94158"/>

        <SolidColorBrush x:Key="ColorBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ColorSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ColorTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="ColorTextSecondary" Color="#64748B"/>

        <!-- Style cho Bottom Tab Button (không active) -->
        <Style TargetType="Button" x:Key="BottomTabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource ColorSkyLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Bottom Tab Button đang active -->
        <Style TargetType="Button" x:Key="BottomTabBtnActive">
            <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,8">
                            <Border.Effect>
                                <DropShadowEffect Color="#425B9A" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource ColorPrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút Tạo Mới (Hồng Pastel nịnh mắt) -->
        <Style TargetType="Button" x:Key="BottomTabCreateBtn">
            <Setter Property="Background" Value="{StaticResource ColorPinkLight}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorPinkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorPinkBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource ColorPink}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BottomTabCreateBtnActive">
            <Setter Property="Background" Value="{StaticResource ColorPink}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,8">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF95A5" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource ColorPinkHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho các textbox trong màn Create -->
        <Style x:Key="CreateTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ColorSky}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho các form trong màn Create -->
        <Style TargetType="Border" x:Key="FormCard">
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#425B9A" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút bấm chính (Call to Action) -->
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ROOT GRID: 3 rows - Header, Content, Bottom Bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>  <!-- Top Header / Project Bar -->
            <RowDefinition Height="*"/>   <!-- Main Content Area -->
            <RowDefinition Height="58"/>  <!-- Bottom Navigation Bar -->
        </Grid.RowDefinitions>

        <!-- ===== TOP HEADER BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource ColorPrimary}" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / App Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource ColorAccent}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18" Foreground="{StaticResource ColorPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Agile Manager" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Workspace" FontSize="11" Foreground="{StaticResource ColorAccent}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Project Selector (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" Foreground="{StaticResource ColorSky}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Dự án:" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource ColorSky}" BorderThickness="1.5" Padding="4,0">
                        <ComboBox x:Name="cboProjects" Width="240" Height="32" FontSize="13" FontWeight="SemiBold"
                                  SelectedValuePath="projectId"
                                  SelectionChanged="CboProjects_SelectionChanged"
                                  Background="White" Foreground="{StaticResource ColorTextPrimary}" BorderThickness="0" Cursor="Hand"
                                  VerticalContentAlignment="Center">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding projectName}" Foreground="{StaticResource ColorTextPrimary}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>
                </StackPanel>

                <!-- User info / Profile badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#33487A" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource ColorSky}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource ColorPink}" CornerRadius="11" Width="22" Height="22" Margin="0,0,8,0">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="lblCurrentUserName" Text="Tài khoản" FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT AREA ===== -->
        <Border Grid.Row="1" Padding="0">
            <Grid>
                <!-- 
                    Layout cho Split View:
                    viewSplit sẽ dùng GridSplitter, các view đơn dùng full width
                -->

                <!-- TAB 1: BẢNG THÔNG TIN (KANBAN DASHBOARD) -->
                <Grid x:Name="panelDashboard" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sub-header Dashboard -->
                        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="24,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource ColorSkyLight}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource ColorPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bảng công việc" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource ColorCream}" BorderBrush="{StaticResource ColorCreamBorder}" BorderThickness="1" CornerRadius="12" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Agile Sprint Board" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorCreamText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Kéo thả thẻ để cập nhật trạng thái tiến độ" FontSize="12" Foreground="{StaticResource ColorTextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- KHU VỰC BẢNG KANBAN -->
                        <ScrollViewer x:Name="svBoard" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      FocusVisualStyle="{x:Null}" Padding="24,20" Background="{StaticResource ColorBackground}"
                                      AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop">
                        <StackPanel Orientation="Horizontal" Background="Transparent" AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop">
                            <ItemsControl x:Name="icBoard" ItemsSource="{Binding Columns}" Focusable="False" FocusVisualStyle="{x:Null}"
                                          Background="Transparent" AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Background="Transparent" AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:KanbanColumn />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- KHU VỰC NHẬP TẠO DANH SÁCH MỚI -->
                            <StackPanel VerticalAlignment="Top" Margin="0,0,16,0">
                                <!-- Nút Thêm Danh Sách -->
                                <Border x:Name="btnShowAddList" Background="White" BorderBrush="{StaticResource ColorAccent}"
                                        BorderThickness="1" CornerRadius="8" Width="280" Height="48" Cursor="Hand"
                                        MouseLeftButtonDown="BtnShowAddList_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource ColorPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblAddListText" Text="Add new list" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Form Nhập Tên Danh Sách -->
                                <Border x:Name="panelAddListInput" Visibility="Collapsed"
                                        Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorPrimary}"
                                        BorderThickness="1" CornerRadius="8" Width="280" Padding="12">
                                    <StackPanel>
                                        <Border Background="{StaticResource ColorBackground}" CornerRadius="6"
                                                BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" Margin="0,0,0,12">
                                            <TextBox x:Name="txtNewListName" MinHeight="40" Padding="12,8"
                                                     BorderThickness="0" Background="Transparent"
                                                     Foreground="{StaticResource ColorTextPrimary}"
                                                     VerticalContentAlignment="Center"
                                                     PreviewKeyDown="TxtNewListName_PreviewKeyDown"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save list" Click="BtnConfirmAddList_Click"
                                                    Background="{StaticResource ColorPrimary}" Foreground="White"
                                                    FontWeight="SemiBold" BorderThickness="0" Padding="16,8" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Click="BtnCancelAddList_Click" FontSize="14" Background="Transparent"
                                                    Foreground="{StaticResource ColorTextSecondary}"
                                                    BorderThickness="0" Margin="12,0,0,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 2: TRÌNH LẬP KẾ HOẠCH (CALENDAR) -->
                <Border x:Name="panelCalendar" Visibility="Collapsed" Background="{StaticResource ColorBackground}">
                    <local:CalendarView x:Name="ucCalendarView"/>
                </Border>

                <!-- TAB 3: FORM TẠO MỚI (CREATE) -->
                <Grid x:Name="viewCreate" Visibility="Collapsed" Margin="28,24" Background="{StaticResource ColorBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form Create User -->
                    <Border x:Name="panelCreateUser" Grid.Column="0" Style="{StaticResource FormCard}">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource ColorAccentLight}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource ColorPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="NGƯỜI DÙNG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                                        <TextBlock Text="Thêm tài khoản thành viên" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Tên đăng nhập" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtUserName" Style="{StaticResource CreateTextBox}"/>

                                <TextBlock Text="Địa chỉ Email" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource CreateTextBox}"/>

                                <TextBlock Text="Mật khẩu" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                    <PasswordBox x:Name="txtPassword" Padding="12,10" Background="Transparent" Foreground="{StaticResource ColorTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Row="1" Content="Tạo Người Dùng" Click="BtnCreateUser_Click" Style="{StaticResource PrimaryBtn}" Background="{StaticResource ColorPrimary}"/>
                        </Grid>
                    </Border>

                    <!-- Form Create Project -->
                    <Border x:Name="panelCreateProject" Grid.Column="1" Style="{StaticResource FormCard}">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource ColorCream}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource ColorCreamText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DỰ ÁN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                                        <TextBlock Text="Khởi tạo dự án mới" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Tên dự án" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtProjectName" Style="{StaticResource CreateTextBox}"/>

                                <TextBlock Text="Người quản lý (Owner)" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                    <ComboBox x:Name="cboOwner" Padding="12,10" Background="Transparent" BorderThickness="0" DisplayMemberPath="username" SelectedValuePath="userId" VerticalContentAlignment="Center" Foreground="{StaticResource ColorTextPrimary}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Row="1" Content="Tạo Dự Án" Click="BtnCreateProject_Click" Style="{StaticResource PrimaryBtn}" Background="{StaticResource ColorPrimary}"/>
                        </Grid>
                    </Border>

                    <!-- Form Create Task -->
                    <Border x:Name="panelCreateTask" Grid.Column="2" Style="{StaticResource FormCard}">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource ColorPinkLight}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource ColorPinkText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CÔNG VIỆC" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                                        <TextBlock Text="Thêm nhiệm vụ vào dự án" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Tên công việc" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtTaskName" Style="{StaticResource CreateTextBox}"/>

                                <TextBlock Text="Thuộc dự án" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                    <ComboBox x:Name="cboProject" Padding="12,10" Background="Transparent" BorderThickness="0" DisplayMemberPath="projectName" SelectedValuePath="projectId" VerticalContentAlignment="Center" Foreground="{StaticResource ColorTextPrimary}"/>
                                </Border>

                                <TextBlock Text="Hạn hoàn thành" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                    <DatePicker x:Name="dpCreateTaskDate" Padding="12,10" Background="Transparent" BorderThickness="0"/>
                                </Border>

                                <TextBlock Text="Khung giờ (Không bắt buộc)" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                    <ComboBox x:Name="cboCreateTaskTime" Padding="12,10" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ColorTextPrimary}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Row="1" Content="Tạo Công Việc" Click="BtnCreateTask_Click" Style="{StaticResource PrimaryBtn}" Background="{StaticResource ColorPink}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF95A5" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBdr" Property="Background" Value="{StaticResource ColorPinkHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== BOTTOM NAVIGATION BAR (Clean Pill Tabs) ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,1,0,0" Padding="12,6">
            <Border.Effect>
                <DropShadowEffect Color="#425B9A" BlurRadius="8" ShadowDepth="-2" Opacity="0.06"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Tab 1: Trình lập kế hoạch (Calendar Toggle) -->
                <Button x:Name="btnMenuCalendar"
                        Style="{StaticResource BottomTabBtn}"
                        Click="btnMenuCalendar_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Trình lập kế hoạch" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tab 2: Bảng thông tin (Kanban Dashboard Toggle) -->
                <Button x:Name="btnMenuDashboard"
                        Style="{StaticResource BottomTabBtnActive}"
                        Click="btnMenuDashboard_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Bảng thông tin" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="24" Fill="{StaticResource ColorBorder}" Margin="12,0"/>

                <!-- Tab 3: Tạo mới (Hồng Pastel nịnh mắt) -->
                <Button x:Name="btnMenuCreate"
                        Style="{StaticResource BottomTabCreateBtn}"
                        Click="btnMenuCreate_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Tạo mới" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="AgileTaskManager.Desktop.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             Background="#F8FAFC"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    <UserControl.Resources>
        <!-- Task Card Template in Calendar Slot -->
        <DataTemplate x:Key="CalendarTaskTemplate">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,3" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect Color="#425B9A" Opacity="0.06" BlurRadius="6" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ColumnName}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Column="0" x:Name="txtCalendarTitle" Text="{Binding ColumnName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="TxtColumnName_LostFocus" KeyDown="TxtColumnName_KeyDown" IsVisibleChanged="TxtCalendarTitle_IsVisibleChanged" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Background="White" BorderThickness="1" BorderBrush="#425B9A" Padding="3,1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1" Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding EditColumnTitleCommand}" Foreground="#64748B" Background="Transparent" BorderThickness="0" FontSize="11" Cursor="Hand" Padding="4,0,0,0" ToolTip="Sửa tên" VerticalAlignment="Top"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Trạng thái: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <ComboBox ItemsSource="{Binding Statuses}" 
                                      SelectedValue="{Binding Status, Mode=TwoWay}"
                                      SelectionChanged="ComboBox_SelectionChanged"
                                      FontSize="11" Padding="4,1" Background="Transparent" Foreground="#1E293B" BorderThickness="0" MinWidth="85">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#1E293B"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Toolbar (Trello style) -->
            <RowDefinition Height="*"/>    <!-- Calendar Timeline Area -->
        </Grid.RowDefinitions>

        <!-- HEADER / TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dòng 1: Tiêu đề ngày/tuần + Nút chuyển chế độ Ngày / Tuần -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tiêu đề ngày/tuần -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="#EAF5FC" Margin="0,0,8,0">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#425B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="lblCalendarHeader" Text="Tuần" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Segmented View Mode Toggle: [ Ngày | Tuần ] (Mặc định Tuần) -->
                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="2" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnViewDay" Content="Ngày" Click="BtnViewDay_Click"
                                    Background="Transparent" Foreground="#64748B" FontWeight="SemiBold" FontSize="12"
                                    Padding="10,4" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="btnViewWeek" Content="Tuần" Click="BtnViewWeek_Click"
                                    Background="#425B9A" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                    Padding="10,4" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Dòng 2: Navigation controls [<] [Hôm nay] [>] + DatePicker -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Lùi: [<] -->
                        <Button Click="Prev_Click" ToolTip="Lùi lại" Width="30" Height="28" Margin="0,0,4,0"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Hôm nay -->
                        <Button Content="Hôm nay" Click="Today_Click" Height="28" Padding="8,0" Margin="0,0,4,0"
                                Background="#EAF5FC" BorderBrush="#76C0EC" BorderThickness="1" Foreground="#425B9A" FontWeight="SemiBold" FontSize="12" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Tiến: [>] -->
                        <Button Click="Next_Click" ToolTip="Tiếp theo" Width="30" Height="28" Margin="0,0,8,0"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- DatePicker gọn gàng -->
                    <DatePicker x:Name="dtpSelectedDate" Grid.Column="1" HorizontalAlignment="Right" Width="120" Height="28"
                                SelectedDateChanged="DtpSelectedDate_SelectedDateChanged"/>
                </Grid>
            </Grid>
        </Border>

        <!-- NỘI DUNG LỊCH: LƯỚI LỊCH (BÊN TRÁI) + CỘT CHƯA XẾP LỊCH (BÊN PHẢI) -->
        <Grid Grid.Row="1" Margin="12,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- LƯỚI LỊCH (CHIẾM PHẦN LỚN DIỆN TÍCH) -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              AllowDrop="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid x:Name="CalendarGrid"
                          Background="Transparent"
                          AllowDrop="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <!-- Được render động theo chế độ Ngày hoặc Tuần -->
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- CỘT CHƯA XẾP LỊCH (UNSCHEDULED TASKS) -->
            <Border Grid.Column="1" Tag="Unscheduled" AllowDrop="True"
                    dd:DragDrop.IsDropTarget="True"
                    dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Opacity="0.03"/>
                </Border.Effect>
                <Grid Tag="Unscheduled">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề cột Chưa xếp lịch -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10" Tag="Unscheduled" AllowDrop="True"
                                dd:DragDrop.IsDropTarget="True"
                                dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EAF5FC" CornerRadius="6" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#425B9A" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtUnscheduledHeader" Tag="Unscheduled" Text="Chưa xếp lịch" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Kéo thẻ vào lịch để đặt giờ hoặc kéo về đây để hủy xếp lịch" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Danh sách thẻ chưa xếp lịch với scroll -->
                    <ScrollViewer Grid.Row="1" Tag="Unscheduled" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AllowDrop="True" dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl x:Name="icUnscheduledTasks" Tag="Unscheduled" ItemsSource="{Binding UnscheduledTasks}"
                                      ItemTemplate="{StaticResource CalendarTaskTemplate}"
                                      AllowDrop="True" Background="Transparent" MinHeight="350"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True"
                                      dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
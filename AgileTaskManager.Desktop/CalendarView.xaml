<UserControl x:Class="AgileTaskManager.Desktop.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             Background="#F3F4F6">
    <UserControl.Resources>
        <DataTemplate x:Key="CalendarTaskTemplate">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="2,4">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="5" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ColumnName}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Column="0" x:Name="txtCalendarTitle" Text="{Binding ColumnName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="TxtColumnName_LostFocus" KeyDown="TxtColumnName_KeyDown" IsVisibleChanged="TxtCalendarTitle_IsVisibleChanged" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Background="White" BorderThickness="1" BorderBrush="#3B82F6" Padding="2">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1" Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding EditColumnTitleCommand}" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="5,0,0,0" ToolTip="Sửa tên" VerticalAlignment="Top"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Trạng thái: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Statuses}" 
                                  SelectedValue="{Binding Status, Mode=TwoWay}"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  FontSize="11" Padding="4,2" Background="#F1F5F9" Foreground="Black" BorderThickness="0" MinWidth="100">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="Black"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header tuần -->
            <RowDefinition Height="*"/>    <!-- Lưới lịch -->
        </Grid.RowDefinitions>

        <!-- Header: Nút chuyển tuần -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblWeekInfo" Text="Tuần (09/11 - 15/11)" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtpSelectedDate" Margin="20,0,10,0" Width="120" SelectedDateChanged="DtpSelectedDate_SelectedDateChanged" />
                <Button Content="&lt; Tuần trước" Margin="10,0,10,0" Padding="10,5" Click="PrevWeek_Click"/>
                <Button Content="Tuần hiện tại" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="10,5" Click="CurrentWeek_Click"/>
                <Button Content="Tuần sau &gt;" Margin="10,0,0,0" Padding="10,5" Click="NextWeek_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Lưới Calendar -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid x:Name="CalendarGrid">
                        <!-- Sẽ được tạo động trong Code-Behind -->
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Danh sách Unscheduled Tasks -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtUnscheduledHeader" Grid.Row="0" Text="Chưa xếp lịch" FontWeight="Bold" FontSize="14" Foreground="#475569" Margin="0,0,0,10" AllowDrop="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UnscheduledTasks}" ItemTemplate="{StaticResource CalendarTaskTemplate}" 
                                      AllowDrop="True" Background="Transparent" MinHeight="500" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      dd:DragDrop.IsDragSource="True" 
                                      dd:DragDrop.IsDropTarget="True" 
                                      dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
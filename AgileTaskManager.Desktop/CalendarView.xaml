<UserControl x:Class="AgileTaskManager.Desktop.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             Background="#F3F4F6">
    <UserControl.Resources>
        <DataTemplate x:Key="CalendarTaskTemplate">
            <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="5" Margin="2" dd:DragDrop.IsDragSource="True" dd:DragDrop.DragDropContext="CalendarTask">
                <StackPanel>
                    <TextBlock Text="{Binding TaskName}" TextWrapping="Wrap" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                              DisplayMemberPath="ColumnName" 
                              SelectedValuePath="ColumnId" 
                              SelectedValue="{Binding ColumnId, Mode=TwoWay}"
                              SelectionChanged="ComboBox_SelectionChanged"
                              FontSize="10" Padding="2"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header tuần -->
            <RowDefinition Height="*"/>    <!-- Lưới lịch -->
        </Grid.RowDefinitions>

        <!-- Header: Nút chuyển tuần -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblWeekInfo" Text="Tuần (09/11 - 15/11)" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtpSelectedDate" Margin="20,0,10,0" Width="120" SelectedDateChanged="DtpSelectedDate_SelectedDateChanged" />
                <Button Content="&lt; Tuần trước" Margin="10,0,10,0" Padding="10,5" Click="PrevWeek_Click"/>
                <Button Content="Tuần hiện tại" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="10,5" Click="CurrentWeek_Click"/>
                <Button Content="Tuần sau &gt;" Margin="10,0,0,0" Padding="10,5" Click="NextWeek_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Lưới Calendar -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="CalendarGrid">
                        <!-- Sẽ được tạo động trong Code-Behind vì số lượng cột/hàng nhiều -->
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Danh sách Unscheduled Tasks -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Chưa xếp lịch" FontWeight="Bold" FontSize="14" Foreground="#475569" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UnscheduledTasks}" ItemTemplate="{StaticResource CalendarTaskTemplate}" 
                                      AllowDrop="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>



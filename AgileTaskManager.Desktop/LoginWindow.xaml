<Window x:Class="AgileTaskManager.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agile Manager - Login" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    
    <Window.Resources>
        <SolidColorBrush x:Key="ColorPrimary" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="ColorSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ColorTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="ColorTextSecondary" Color="#64748B"/>
    </Window.Resources>

    <Grid>
        <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="12" Margin="32" Padding="24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng nhập" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                
                <TextBlock Text="Email" Foreground="{StaticResource ColorTextSecondary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                    <TextBox x:Name="txtEmail" Padding="12,10" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ColorTextPrimary}"/>
                </Border>

                <TextBlock Text="Mật khẩu" Foreground="{StaticResource ColorTextSecondary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Background="{StaticResource ColorSurface}" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,24">
                    <PasswordBox x:Name="txtPassword" Padding="12,10" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ColorTextPrimary}"/>
                </Border>

                <Button Content="ĐĂNG NHẬP" Click="BtnLogin_Click" Background="{StaticResource ColorPrimary}" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <TextBlock x:Name="lblMessage" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
